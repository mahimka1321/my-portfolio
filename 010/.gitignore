# --- ЗАВИСИМОСТИ И СБОРКА ---
# Блокируем тяжелую папку библиотек (ее робот Actions качает сам на сервере)
/node_modules
/.pnp
.pnp.js
/coverage
/build

# --- СЕКРЕТНЫЕ КЛЮЧИ И ТОКЕНЫ (ТВОЯ БЕЗОПАСНОСТЬ) ---
# Намертво глушим файлы переменных окружения, чтобы твой токен гитхаба никогда не улетел в сеть
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- СИСТЕМНЫЙ МУСОР ОПЕРАЦИОННЫХ СИСТЕМ ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --- ЛОГИ И ОТЧЕТЫ ОБ ОШИБКАХ ---
# Срезаем файлы отчетов, которые создают npm и yarn при сбоях
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- НАСТРОЙКИ РЕДАКТОРОВ КОДА ---
# Игнорируем внутренние папки настроек VS Code и других IDE
/.vscode/
/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp